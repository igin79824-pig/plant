// 答題紀錄
let userAnswers = new Array(allQuestions.length).fill(null);
let currentDimId = 1;

// 初始化
window.onload = function() {
  renderDimensionView(1);
  renderAllQuestionsView();
  updateProgressBadges();
};

// 切換頂部主要模式
function switchMainMode(mode) {
  document.querySelectorAll(".top-tab-btn").forEach(btn => btn.classList.remove("active"));
  document.getElementById("mode-dimension").classList.add("hidden");
  document.getElementById("mode-allq").classList.add("hidden");
  document.getElementById("mode-report").classList.add("hidden");
  
  const dimWrapper = document.getElementById("dim-tabs-wrapper");

  if (mode === 'dimension') {
    event.target.classList.add("active");
    document.getElementById("mode-dimension").classList.remove("hidden");
    dimWrapper.classList.remove("hidden");
    renderDimensionView(currentDimId);
  } else if (mode === 'allq') {
    event.target.classList.add("active");
    document.getElementById("mode-allq").classList.remove("hidden");
    dimWrapper.classList.add("hidden");
    renderAllQuestionsView();
  } else if (mode === 'report') {
    event.target.classList.add("active");
    document.getElementById("mode-report").classList.remove("hidden");
    dimWrapper.classList.add("hidden");
    generateAssessmentReport();
  }
}

// 切換素養分頁
function switchDimension(dimId) {
  currentDimId = dimId;
  document.querySelectorAll(".dim-tab-btn").forEach((btn, idx) => {
    btn.classList.toggle("active", idx + 1 === dimId);
  });
  renderDimensionView(dimId);
}

function nextDimensionTab() {
  if (currentDimId < 6) {
    switchDimension(currentDimId + 1);
    window.scrollTo({ top: 120, behavior: 'smooth' });
  } else {
    switchMainMode('report');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }
}

// 渲染特定素養分頁內容
function renderDimensionView(dimId) {
  const data = dimensionsData[dimId];

  // 1. 素養橫幅
  document.getElementById("dim-banner").innerHTML = `
    <h2>${data.icon} 第 ${dimId} 核心素養：${data.name}</h2>
    <p>${data.desc}</p>
  `;

  // 2. 圖像化百寶箱
  document.getElementById("dim-visual-card").innerHTML = `
    <h3>🎨 ${data.name}・圖像化圖解速記</h3>
    <div class="ency-svg-wrap">${data.svg}</div>
    <div class="ency-keypoints">
      <b>📌 本向度核心觀念筆記：</b>
      <ul>
        ${data.keypoints.map(pt => `<li>${pt}</li>`).join('')}
      </ul>
    </div>
  `;

  // 3. 素養情境題組
  let caseHtml = `
    <h3>🔍 ${data.caseTitle}</h3>
    <p><b>📖 情境觀察任務：</b><br>${data.caseStory}</p>
    <div style="margin-top:14px;">
  `;
  data.caseQ.forEach((cq, cIdx) => {
    caseHtml += `
      <div style="background:white; padding:12px 14px; border-radius:10px; margin-bottom:12px; border:1px solid #b2dfdb;">
        <div style="font-weight:bold; color:#00695c; margin-bottom:8px;">子題 ${cIdx+1}. ${cq.q}</div>
        <div class="options-list">
          ${cq.opts.map((opt, oIdx) => `
            <button class="opt-btn" onclick="checkCaseAnswer(this, ${cq.a}, ${oIdx}, '${cq.e.replace(/'/g, "\\'")}')">
              ${["(A)","(B)","(C)","(D)"][oIdx]} ${opt}
            </button>
          `).join('')}
        </div>
        <div class="explain-box" style="display:none;"></div>
      </div>
    `;
  });
  caseHtml += `</div>`;
  document.getElementById("dim-case-box").innerHTML = caseHtml;

  // 4. 單元測驗題目
  renderDimensionQuestions(dimId);
}

// 渲染該素養對應的選擇題
function renderDimensionQuestions(dimId) {
  const qList = dimensionsData[dimId].qIndices;
  const container = document.getElementById("dim-questions-list");
  container.innerHTML = "";

  let answeredCount = 0;
  let correctCount = 0;

  qList.forEach(qIdx => {
    const q = allQuestions[qIdx];
    const isAnswered = (userAnswers[qIdx] !== null);
    if (isAnswered) {
      answeredCount++;
      if (userAnswers[qIdx] === q.a) correctCount++;
    }

    const item = document.createElement("div");
    item.className = "q-item";
    if (isAnswered) {
      item.classList.add(userAnswers[qIdx] === q.a ? "correct-answered" : "wrong-answered");
    }

    let html = `
      <div class="q-header">
        <span class="q-num">第 ${qIdx + 1} 題</span>
        <div class="q-title">${q.q}</div>
      </div>
      <div class="options-list">
        ${q.opts.map((opt, oIdx) => {
          let btnClass = "opt-btn";
          if (isAnswered) {
            if (oIdx === q.a) btnClass += " correct";
            if (userAnswers[qIdx] === oIdx && oIdx !== q.a) btnClass += " wrong";
          }
          return `
            <button class="${btnClass}" ${isAnswered ? 'disabled' : ''} onclick="answerQuestion(${qIdx}, ${oIdx})">
              <b>${["(A)","(B)","(C)","(D)"][oIdx]}</b> ${opt}
            </button>
          `;
        }).join('')}
      </div>
      <div class="explain-box" style="display:${isAnswered ? 'block' : 'none'}">
        💡 <b>解析：</b>${q.e}
      </div>
    `;

    item.innerHTML = html;
    container.appendChild(item);
  });

  document.getElementById("dim-q-count").textContent = `本向度進度：${answeredCount} / ${qList.length} 題`;
  document.getElementById("dim-score-badge").textContent = `向度答對率：${qList.length > 0 ? Math.round((correctCount/qList.length)*100) : 0}% (${correctCount}/${qList.length})`;
}

// 渲染全部題目清單
function renderAllQuestionsView() {
  const container = document.getElementById("all-questions-list");
  container.innerHTML = "";

  let answeredCount = 0;
  let totalScore = 0;

  allQuestions.forEach((q, qIdx) => {
    const isAnswered = (userAnswers[qIdx] !== null);
    if (isAnswered) {
      answeredCount++;
      if (userAnswers[qIdx] === q.a) totalScore += 2;
    }

    const item = document.createElement("div");
    item.className = "q-item";
    if (isAnswered) {
      item.classList.add(userAnswers[qIdx] === q.a ? "correct-answered" : "wrong-answered");
    }

    let html = `
      <div class="q-header">
        <span class="q-num">Q${qIdx + 1}</span>
        <div class="q-title">${q.q}</div>
      </div>
      <div class="options-list">
        ${q.opts.map((opt, oIdx) => {
          let btnClass = "opt-btn";
          if (isAnswered) {
            if (oIdx === q.a) btnClass += " correct";
            if (userAnswers[qIdx] === oIdx && oIdx !== q.a) btnClass += " wrong";
          }
          return `
            <button class="${btnClass}" ${isAnswered ? 'disabled' : ''} onclick="answerQuestion(${qIdx}, ${oIdx})">
              <b>${["(A)","(B)","(C)","(D)"][oIdx]}</b> ${opt}
            </button>
          `;
        }).join('')}
      </div>
      <div class="explain-box" style="display:${isAnswered ? 'block' : 'none'}">
        💡 <b>解析：</b>${q.e}
      </div>
    `;

    item.innerHTML = html;
    container.appendChild(item);
  });

  document.getElementById("all-progress").textContent = `總進度：${answeredCount} / ${allQuestions.length} 題`;
  document.getElementById("all-score").textContent = `總得分：${totalScore} / 100 分`;
}

// 作答處理
function answerQuestion(qIdx, choice) {
  userAnswers[qIdx] = choice;
  if (choice === allQuestions[qIdx].a) {
    soundCorrect();
  } else {
    soundWrong();
  }

  // 更新介面
  renderDimensionQuestions(currentDimId);
  renderAllQuestionsView();
  updateProgressBadges();
}

// 情境題作答
function checkCaseAnswer(btn, correctOpt, userOpt, explain) {
  const parent = btn.parentElement;
  const explainBox = parent.parentElement.querySelector(".explain-box");
  const buttons = parent.querySelectorAll(".opt-btn");

  buttons.forEach((b, idx) => {
    b.disabled = true;
    if (idx === correctOpt) b.classList.add("correct");
    if (idx === userOpt && userOpt !== correctOpt) b.classList.add("wrong");
  });

  if (userOpt === correctOpt) {
    soundCorrect();
  } else {
    soundWrong();
  }

  explainBox.innerHTML = `💡 <b>情境探究解析：</b>${explain}`;
  explainBox.style.display = "block";
}

// 更新上方各素養按鈕的小標籤
function updateProgressBadges() {
  for (let d = 1; d <= 6; d++) {
    const list = dimensionsData[d].qIndices;
    let done = 0;
    list.forEach(idx => {
      if (userAnswers[idx] !== null) done++;
    });
    const badge = document.getElementById(`badge-d${d}`);
    if (badge) badge.textContent = `${done}/${list.length}`;
  }
}

// 生成素養評估診斷報告
function generateAssessmentReport() {
  let totalCorrect = 0;
  let totalAnswered = 0;
  const dimStats = {};

  for (let d = 1; d <= 6; d++) {
    const list = dimensionsData[d].qIndices;
    let cor = 0;
    let ans = 0;
    list.forEach(idx => {
      if (userAnswers[idx] !== null) {
        ans++;
        if (userAnswers[idx] === allQuestions[idx].a) cor++;
      }
    });
    dimStats[d] = { total: list.length, ans, cor, rate: list.length > 0 ? (cor / list.length) : 0 };
    totalCorrect += cor;
    totalAnswered += ans;
  }

  const finalScore = totalCorrect * 2;
  document.getElementById("hero-badge-score").textContent = `總分：${finalScore} 分（答對 ${totalCorrect} / ${allQuestions.length} 題）`;

  // 評定榮譽稱號
  let icon = "🌱", title = "植物見習小種子", desc = "剛剛發芽的小探險家，建議前往各素養分頁觀看圖解知識，累積更多綠色能量！";
  if (finalScore >= 90) {
    icon = "👑"; title = "小小神農大師"; desc = "太卓越了！對植物構造、葉序、根系到日常生活應用皆瞭若指掌，具備超凡的自然素養！";
  } else if (finalScore >= 80) {
    icon = "🌟"; title = "植物探險隊長"; desc = "非常優秀！精通絕大多數植物知識，只要再補齊少數易混淆細節，就是滿分達人！";
  } else if (finalScore >= 60) {
    icon = "🌿"; title = "綠意實習達人"; desc = "表現良好！已掌握植物基本生命特徵，建議針對較弱的素養向度進行複習。";
  }
  document.getElementById("hero-badge-icon").textContent = icon;
  document.getElementById("hero-badge-title").textContent = title;
  document.getElementById("hero-badge-desc").textContent = desc;

  // 渲染六大素養進度條
  const grid = document.getElementById("dim-report-grid");
  grid.innerHTML = "";
  let lowestDim = 1;
  let minRate = 1.1;

  for (let d = 1; d <= 6; d++) {
    const s = dimStats[d];
    const pct = Math.round(s.rate * 100);
    if (s.rate < minRate) { minRate = s.rate; lowestDim = d; }

    const card = document.createElement("div");
    card.className = "dim-progress-card";
    card.innerHTML = `
      <div class="dim-p-title">
        <span>${dimensionsData[d].icon} ${dimensionsData[d].name}</span>
        <span>${pct}% (${s.cor}/${s.total})</span>
      </div>
      <div class="dim-bar-wrap">
        <div class="dim-bar-inner" style="width:${pct}%;"></div>
      </div>
      <div class="dim-status-txt">
        ${s.ans < s.total ? `⚠️ 尚有 ${s.total - s.ans} 題未作答` : '✅ 本向度已全數完成作答'}
      </div>
    `;
    grid.appendChild(card);
  }

  // 導師複習建議
  const adviceDiv = document.getElementById("learning-advice");
  if (totalAnswered === 0) {
    adviceDiv.innerHTML = "您尚未開始作答，請點選上方【📂 核心素養分頁專區】開始挑戰！";
  } else {
    const targetDim = dimensionsData[lowestDim];
    adviceDiv.innerHTML = `
      根據答題數據，您在<b>【${targetDim.icon} 第 ${lowestDim} 素養向度：${targetDim.name}】</b>的答對率相對較低或未作答題目較多。<br>
      👉 <b>強烈建議行動：</b>點擊回到「${targetDim.name}」分頁，仔細觀看圖解速記卡，並複習<b>${targetDim.keypoints[0]}</b>等核心概念！
    `;
  }

  // 錯題清單彙整
  const wrongListDiv = document.getElementById("wrong-list-container");
  const wrongItems = [];
  userAnswers.forEach((ans, idx) => {
    if (ans !== null && ans !== allQuestions[idx].a) {
      wrongItems.push({ idx, q: allQuestions[idx], userAns: ans });
    }
  });

  if (wrongItems.length === 0) {
    wrongListDiv.innerHTML = (totalAnswered === 0) ? "<p style='color:#666;'>尚無作答紀錄。</p>" : "<p style='color:#2e7d32; font-weight:bold;'>🎉 太厲害了！目前沒有任何錯題！</p>";
  } else {
    wrongListDiv.innerHTML = wrongItems.map(item => `
      <div style="background:#fffaf0; border-left:4px solid #f44336; padding:12px 14px; margin-bottom:10px; border-radius:6px;">
        <div style="font-weight:bold; color:#b71c1c; margin-bottom:4px;">
          第 ${item.idx + 1} 題：${item.q.q}
        </div>
        <div style="font-size:0.92rem; color:#555; margin-bottom:4px;">
          ❌ 您的選擇：<b>${item.q.opts[item.userAns]}</b> ｜ ✅ 正確解答：<b>${item.q.opts[item.q.a]}</b>
        </div>
        <div style="font-size:0.9rem; color:#2e7d32; background:#ffffff; padding:6px 10px; border-radius:6px; border:1px solid #e0e0e0;">
          💡 <b>重點提醒：</b>${item.q.e}
        </div>
      </div>
    `).join('');
  }
}

// 重新測驗
function resetAllQuiz() {
  if (confirm("確定要重置所有答題紀錄重新挑戰嗎？")) {
    userAnswers.fill(null);
    updateProgressBadges();
    renderDimensionView(currentDimId);
    renderAllQuestionsView();
    generateAssessmentReport();
    switchDimension(1);
    switchMainMode('dimension');
  }
}
</script>

</body>
</html>
